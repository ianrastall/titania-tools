<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PgnSimpleEdit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PgnSimpleEdit"
    xmlns:vm="using:PgnSimpleEdit.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- One card of the report: a title and its lines, each with an optional bar. -->
            <DataTemplate x:Key="SectionTemplate" x:DataType="vm:ReportSection">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{x:Bind Rows}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatRow">
                                    <Grid Margin="0,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Value}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Maximum="100" Value="{x:Bind Percent}"
                                                     Visibility="{x:Bind local:Ui.Show(HasBar)}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="&#x265E;" FontFamily="Segoe UI Symbol" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Text="PGN Simple Edit" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Menu -->
        <MenuBar Grid.Row="1" Margin="4,0,0,0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Add files…" Icon="OpenFile" Command="{x:Bind ViewModel.AddFilesCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Remove from the list" Icon="Remove" Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Clear the list" Icon="Clear" Command="{x:Bind ViewModel.ClearFilesCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Move up" Icon="Up" Command="{x:Bind ViewModel.MoveUpCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Move down" Command="{x:Bind ViewModel.MoveDownCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74B;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Down" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Command="{x:Bind ViewModel.ExitCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Info" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Info">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Join" Icon="Link" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Join">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Merge" Icon="Import" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Merge">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Split" Icon="Cut" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Split">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number4" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Sort" Icon="Sort" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Sort">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Run" Icon="Play" Command="{x:Bind ViewModel.RunCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Cancel" Icon="Cancel" Command="{x:Bind ViewModel.CancelCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem Text="Activity log" IsChecked="{x:Bind ViewModel.ShowLog, Mode=TwoWay}">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutItem Text="Clear the log" Command="{x:Bind ViewModel.ClearLogCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Show the last result in Explorer" Icon="Folder" Command="{x:Bind ViewModel.ShowOutputCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About PGN Simple Edit" Command="{x:Bind ViewModel.AboutCommand}" />
            </MenuBarItem>
        </MenuBar>

        <!-- Toolbar -->
        <CommandBar Grid.Row="2" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent"
                    OverflowButtonVisibility="Collapsed" Margin="4,0,0,4">
            <AppBarButton Icon="OpenFile" Label="Add files" Command="{x:Bind ViewModel.AddFilesCommand}"
                          ToolTipService.ToolTip="Add PGN files to the list (Ctrl+O)" />
            <AppBarButton Icon="Remove" Label="Remove" Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                          ToolTipService.ToolTip="Remove the selected file from the list (Delete)" />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="InfoButton" Label="Info" Tag="Info" Click="OnToolClick"
                                ToolTipService.ToolTip="See what is inside a file (Ctrl+1)">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton x:Name="JoinButton" Icon="Link" Label="Join" Tag="Join" Click="OnToolClick"
                                ToolTipService.ToolTip="Put files end to end (Ctrl+2)" />
            <AppBarToggleButton x:Name="MergeButton" Icon="Import" Label="Merge" Tag="Merge" Click="OnToolClick"
                                ToolTipService.ToolTip="Combine files without duplicates (Ctrl+3)" />
            <AppBarToggleButton x:Name="SplitButton" Icon="Cut" Label="Split" Tag="Split" Click="OnToolClick"
                                ToolTipService.ToolTip="Break a file into smaller files (Ctrl+4)" />
            <AppBarToggleButton x:Name="SortButton" Icon="Sort" Label="Sort" Tag="Sort" Click="OnToolClick"
                                ToolTipService.ToolTip="Put the games of a file in order (Ctrl+5)" />
            <AppBarSeparator />
            <AppBarButton Icon="Play" Label="Run" Command="{x:Bind ViewModel.RunCommand}" ToolTipService.ToolTip="Run the chosen tool (F5)" />
            <AppBarButton Icon="Cancel" Label="Cancel" Command="{x:Bind ViewModel.CancelCommand}" ToolTipService.ToolTip="Stop the running tool (Esc)" />
        </CommandBar>

        <!-- Work area -->
        <Grid Grid.Row="3" Padding="12,0,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the list of files -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Files" Style="{StaticResource CardTitle}" Margin="16,14,16,8" />
                    <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}"
                              SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <StackPanel Padding="0,7" Spacing="1" ToolTipService.ToolTip="{x:Bind Path}">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24" Spacing="12"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.HasNoFiles), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Drop PGN files here, or use Add files." Style="{StaticResource Secondary}"
                                   HorizontalAlignment="Center" HorizontalTextAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="2" Padding="8" ColumnSpacing="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Add files…" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddFilesCommand}" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.MoveUpCommand}" ToolTipService.ToolTip="Move up (Alt+Up)">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.MoveDownCommand}" ToolTipService.ToolTip="Move down (Alt+Down)">
                            <FontIcon Glyph="&#xE74B;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.RemoveSelectedCommand}" ToolTipService.ToolTip="Remove from the list (Delete)">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: the chosen tool -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2" Margin="4,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.ToolTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ToolDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Spacing="12">

                        <!-- Info: the report on the selected file -->
                        <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Show(ViewModel.IsInfo), Mode=OneWay}">
                            <Border Style="{StaticResource Card}" Padding="24" Visibility="{x:Bind local:Ui.Hide(ViewModel.IsInfoReady), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsInfoReading, Mode=OneWay}"
                                                  Visibility="{x:Bind local:Ui.Show(ViewModel.IsInfoReading), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{x:Bind local:Ui.Show(ViewModel.IsInfoReady), Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tiles}" Margin="0,0,0,12">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="150" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Tile">
                                            <Border Style="{StaticResource Card}" Padding="14,10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource Secondary}" />
                                                    <TextBlock Text="{x:Bind Value}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Value}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.LeftSections}" ItemTemplate="{StaticResource SectionTemplate}" IsTabStop="False" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RightSections}" ItemTemplate="{StaticResource SectionTemplate}" IsTabStop="False" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Join has nothing to choose -->

                        <!-- Merge options -->
                        <Border Style="{StaticResource Card}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsMerge), Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <CheckBox Content="Leave out duplicate games" IsChecked="{x:Bind ViewModel.MergeRemoveDuplicates, Mode=TwoWay}" />
                                    <TextBlock Text="Two games are duplicates when they have the same players, the same date and the same moves. The first one found is kept."
                                               Style="{StaticResource Secondary}" Margin="28,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Put the games in order by" Width="280" ItemsSource="{x:Bind ViewModel.MergeOrders}"
                                              SelectedIndex="{x:Bind ViewModel.MergeOrderIndex, Mode=TwoWay}" />
                                    <CheckBox Content="Reverse order" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.MergeDescending, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.MergeIsSorted, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Split options -->
                        <Border Style="{StaticResource Card}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsSplit), Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <ComboBox Header="Split into" Width="320" ItemsSource="{x:Bind ViewModel.SplitModes}"
                                          SelectedIndex="{x:Bind ViewModel.SplitModeIndex, Mode=TwoWay}" />
                                <NumberBox Header="Games in each file" Width="200" HorizontalAlignment="Left" Minimum="1" Maximum="100000000"
                                           SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000"
                                           Value="{x:Bind ViewModel.GamesPerFile, Mode=TwoWay}"
                                           Visibility="{x:Bind local:Ui.Show(ViewModel.SplitNeedsGames), Mode=OneWay}" />
                                <NumberBox Header="Number of files" Width="200" HorizontalAlignment="Left" Minimum="2" Maximum="5000"
                                           SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10"
                                           Value="{x:Bind ViewModel.NumberOfFiles, Mode=TwoWay}"
                                           Visibility="{x:Bind local:Ui.Show(ViewModel.SplitNeedsFiles), Mode=OneWay}" />
                                <TextBlock Text="The new files are named after the original, with the part added at the end: games_001.pgn, games_1998.pgn, games_draws.pgn."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Sort options -->
                        <Border Style="{StaticResource Card}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsSort), Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Sort by" Width="240" ItemsSource="{x:Bind ViewModel.SortFields}"
                                              SelectedIndex="{x:Bind ViewModel.SortField1, Mode=TwoWay}" />
                                    <CheckBox Content="Reverse order" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.SortDescending1, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Then by" Width="240" ItemsSource="{x:Bind ViewModel.OptionalSortFields}"
                                              SelectedIndex="{x:Bind ViewModel.SortField2, Mode=TwoWay}" />
                                    <CheckBox Content="Reverse order" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.SortDescending2, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox Header="Then by" Width="240" ItemsSource="{x:Bind ViewModel.OptionalSortFields}"
                                              SelectedIndex="{x:Bind ViewModel.SortField3, Mode=TwoWay}" />
                                    <CheckBox Content="Reverse order" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.SortDescending3, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Text="Normal order is oldest first, A to Z, lowest first. Games that are equal keep the order they had."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <!-- The action: which files, and the button that starts it -->
                        <Border Style="{StaticResource Card}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsAction), Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.InputHint, Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Bind ViewModel.RunLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.RunCommand}" MinWidth="180" />
                                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                                            Visibility="{x:Bind local:Ui.Show(ViewModel.IsBusy), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="The original files are never changed." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <InfoBar IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}" Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                                 Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                                 Visibility="{x:Bind local:Ui.Show(ViewModel.IsAction), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <Button Content="Show in Explorer" Command="{x:Bind ViewModel.ShowOutputCommand}"
                                        Visibility="{x:Bind local:Ui.Show(ViewModel.CanShowOutput), Mode=OneWay}" />
                                <Button Content="Add it to the list" Command="{x:Bind ViewModel.AddOutputCommand}"
                                        Visibility="{x:Bind local:Ui.Show(ViewModel.CanAddOutput), Mode=OneWay}" />
                            </StackPanel>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Activity: progress and the log -->
        <Border Grid.Row="4" Margin="12,0,12,12" Style="{StaticResource Card}" Padding="0"
                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowLog), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="132" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10,16,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Activity" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Maximum="100"
                                 Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                 Visibility="{x:Bind local:Ui.Show(ViewModel.IsProgressVisible), Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource StatusText}" MaxWidth="420" />
                </Grid>
                <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Log}" SelectionMode="None" Padding="8,0,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5" Padding="14,5" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource StatusText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Style="{StaticResource StatusText}" />
                <TextBlock Grid.Column="2" Style="{StaticResource StatusText}">
                    <Run Text="Core" />
                    <Run Text="{x:Bind ViewModel.CoreVersion}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
